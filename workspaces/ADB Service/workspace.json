{
  "description": "ADB service container for installing and managing Android apps over the network.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "adb-service.png",
  "run_config": {
    "hostname": "adbd"
  },
  "categories": [
    "Development",
    "Utility"
  ],
  "friendly_name": "ADB Service",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "notes": "Use adb -H <workspace-ip> -P 5037 from another workspace/client to connect to this daemon.",
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "gounthar/docker-adb:latest",
      "uncompressed_size_mb": 0,
      "available_tags": [
        "latest"
      ]
    },
    {
      "version": "1.18.x",
      "image": "gounthar/docker-adb:latest",
      "uncompressed_size_mb": 0,
      "available_tags": [
        "latest"
      ]
    }
  ]
}
