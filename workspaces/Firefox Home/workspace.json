{
  "description": "A minimal Firefox workspace designed for home-network use. It opens a single preconfigured URL on launch, ideal as a quick-access portal to local services such as Home Assistant, router admin pages, or media servers. Set your target URL via the KASM_URL environment variable in the workspace settings.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "firefox-home.png",
  "run_config": {
    "hostname": "kasm",
    "environment": {
      "KASM_URL": "http://192.168.1.1"
    }
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Browser",
    "Home Network"
  ],
  "friendly_name": "Firefox Home",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "kasmweb/firefox:develop",
      "uncompressed_size_mb": 2170,
      "available_tags": [
        "develop"
      ]
    }
  ]
}
